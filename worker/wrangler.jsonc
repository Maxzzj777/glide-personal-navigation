{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glide-navigation-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "triggers": {
    "crons": ["55 15 * * *"]
  },
  "routes": [
    {
      "pattern": "glide777.kdns.fr/api/*",
      "zone_name": "glide777.kdns.fr"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GLIDE_KV",
      "id": "33c4efb673ec4220ae3f490d322bd951"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
